[Unit]
Description=Steam portfolio: database backup (daily on server, weekly to Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=steamfolio
Group=steamfolio
EnvironmentFile=/etc/steamfolio/steamfolio.env
ExecStart=/opt/steamfolio/venv/bin/steamfolio backup --scheduled
TimeoutStartSec=30min

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/steamfolio
