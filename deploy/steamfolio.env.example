# Настройки «Портфолио Steam». На сервере: /etc/steamfolio/steamfolio.env
STEAMFOLIO_DB=/var/lib/steamfolio/steamfolio.db

# Адрес сайта: для него Caddy выпускает и продлевает сертификат HTTPS
STEAMFOLIO_DOMAIN=steamportfolio.duckdns.org

# Пауза между запросами к Steam, секунды
STEAMFOLIO_REQUEST_DELAY=2.5

# Прокси, если Steam начнёт блокировать IP сервера
#STEAMFOLIO_PROXY=http://user:pass@host:port

# Предметы для курса Steam (через «;»), по умолчанию — 5 ножей за $800–1500
#STEAMFOLIO_RATE_ITEMS="★ Karambit | Doppler (Factory New);★ Karambit | Fade (Factory New)"
#STEAMFOLIO_MIN_RATE_ITEM_USD=500
#STEAMFOLIO_MIN_RATE_SAMPLES=3
